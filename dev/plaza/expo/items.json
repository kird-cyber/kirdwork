[{"sec": "map", "id": "map_B01", "t": "글로벌 정착 거리", "c": ""}, {"sec": "map", "id": "map_B02", "t": "글로벌 커리어 살롱", "c": ""}, {"sec": "map", "id": "map_B03", "t": "K-STAR 인턴십 설원", "c": ""}, {"sec": "map", "id": "map_B04", "t": "리얼챌린지 화산", "c": ""}, {"sec": "map", "id": "map_B05", "t": "포닥 설산", "c": ""}, {"sec": "map", "id": "map_B06", "t": "커리어 콘서트 광장", "c": ""}, {"sec": "map", "id": "map_B07", "t": "의사과학자 사막", "c": ""}, {"sec": "map", "id": "map_B08", "t": "IRIS 관제 캠퍼스", "c": ""}, {"sec": "map", "id": "map_B09", "t": "AI 네온 시티", "c": ""}, {"sec": "map", "id": "map_B10", "t": "달 기지 교육원", "c": ""}, {"sec": "map", "id": "map_B11", "t": "양자 얽힘 기지", "c": ""}, {"sec": "map", "id": "map_B12", "t": "첨단해양 호수", "c": ""}, {"sec": "map", "id": "map_B13", "t": "기획·평가·관리 언덕", "c": ""}, {"sec": "map", "id": "map_B14", "t": "입문 생활관", "c": ""}, {"sec": "map", "id": "map_B15", "t": "정책기획 고원", "c": ""}, {"sec": "map", "id": "map_B16", "t": "Plan–Do–See 계단", "c": ""}, {"sec": "map", "id": "map_B17", "t": "글로벌 설원", "c": ""}, {"sec": "map", "id": "map_B18", "t": "연구보안 요새", "c": ""}, {"sec": "map", "id": "map_B19", "t": "리더의 고지", "c": ""}, {"sec": "map", "id": "map_B20", "t": "인재개발 컨설팅 사막", "c": ""}, {"sec": "map", "id": "map_B21", "t": "전략연구 지휘소", "c": ""}, {"sec": "map", "id": "map_B22", "t": "KIRD 채용 캠퍼스", "c": ""}, {"sec": "map", "id": "map_B23", "t": "송대제 화합전", "c": ""}, {"sec": "map", "id": "map_B24", "t": "2050 비전 고원", "c": ""}, {"sec": "map", "id": "map_B25", "t": "배지 수집 캠퍼스", "c": ""}, {"sec": "map", "id": "map_B26", "t": "AI 튜터 계곡", "c": ""}, {"sec": "map", "id": "map_B27", "t": "정책 입문 캠퍼스", "c": ""}, {"sec": "map", "id": "map_B28", "t": "연구경력 탐색 언덕", "c": ""}, {"sec": "map", "id": "map_B29", "t": "배리어프리 송대", "c": ""}, {"sec": "map", "id": "map_B30", "t": "러닝랩 계곡", "c": ""}, {"sec": "map", "id": "map_B31", "t": "하이브리드 캠퍼스", "c": ""}, {"sec": "tank", "id": "tank_T01", "t": "맵·탱크 추가만으로 새 과정 — 전용 탱크 10종", "c": ""}, {"sec": "tank", "id": "tank_T02", "t": "과정 전용 탱크 02", "c": ""}, {"sec": "tank", "id": "tank_T03", "t": "과정 전용 탱크 03", "c": ""}, {"sec": "tank", "id": "tank_T04", "t": "과정 전용 탱크 04", "c": ""}, {"sec": "tank", "id": "tank_T05", "t": "과정 전용 탱크 05", "c": ""}, {"sec": "tank", "id": "tank_T06", "t": "과정 전용 탱크 06", "c": ""}, {"sec": "tank", "id": "tank_T07", "t": "과정 전용 탱크 07", "c": ""}, {"sec": "scene", "id": "scene_A01", "t": "원조 IRB 승인집", "c": ""}, {"sec": "scene", "id": "scene_A02", "t": "연구부정 지명수배", "c": ""}, {"sec": "scene", "id": "scene_A03", "t": "「표절」 도장 낙하", "c": ""}, {"sec": "scene", "id": "scene_A04", "t": "만년필 다리 위의 K-블루", "c": ""}, {"sec": "scene", "id": "scene_A05", "t": "보호구부터 챙기고", "c": ""}, {"sec": "scene", "id": "scene_A06", "t": "연구실 화재 발생", "c": ""}, {"sec": "scene", "id": "scene_A07", "t": "증빙 보관 5년", "c": ""}, {"sec": "scene", "id": "scene_A08", "t": "연구혁신비 신메뉴", "c": ""}, {"sec": "scene", "id": "scene_A09", "t": "단계평가 관문", "c": ""}, {"sec": "scene", "id": "scene_A10", "t": "최종보고서와 성과 트로피", "c": ""}, {"sec": "scene", "id": "scene_A11", "t": "KIRD 캠퍼스 4대4", "c": ""}, {"sec": "scene", "id": "scene_A12", "t": "송대제 한 판", "c": ""}, {"sec": "scene", "id": "scene_A13", "t": "위조 회오리", "c": ""}, {"sec": "scene", "id": "scene_A14", "t": "검증의 빛", "c": ""}, {"sec": "scene", "id": "scene_A15", "t": "공동연구 콤비", "c": ""}, {"sec": "scene", "id": "scene_A16", "t": "지휘와 사수", "c": ""}, {"sec": "scene", "id": "scene_A17", "t": "「환수」 도장", "c": ""}, {"sec": "scene", "id": "scene_A18", "t": "3책5공 회오리", "c": ""}, {"sec": "scene", "id": "scene_A19", "t": "측정 결과표 위에서", "c": ""}, {"sec": "scene", "id": "scene_A20", "t": "MSDS와 경고표지", "c": ""}, {"sec": "escape", "id": "game_A01", "t": "테마 고르기", "c": "교육 주제마다 방 하나 — 혼자 기록 도전 또는 2~4명 협동으로 시작합니다."}, {"sec": "escape", "id": "game_A02", "t": "캠퍼스 전체 지도", "c": "지도(M)를 열면 KIRD 캠퍼스 전체와 방 위치가 보입니다 — 풀린 방은 열림, 다음 방은 잠김."}, {"sec": "escape", "id": "game_A03", "t": "캠퍼스를 걸어서 이동", "c": "바깥은 넓은 지도 — 내 탱크를 몰아 건물 문 앞에 서면 「들어가기」 버튼이 뜹니다."}, {"sec": "escape", "id": "game_A04", "t": "문을 지나면 실내로", "c": "문 = 연결 지점. 0.3초 어두워졌다가 건물 안 확대 화면이 열립니다 (포켓몬식 문 이동)."}, {"sec": "escape", "id": "game_A05", "t": "방 안 둘러보기", "c": "조사할 수 있는 물건은 반짝입니다 — 다가가 E(조사)를 누르면 단서가 열립니다."}, {"sec": "escape", "id": "game_A06", "t": "단서 읽기", "c": "단서는 규정 문장 그대로 — 읽고 이해해야 다음 자물쇠의 답이 보입니다."}, {"sec": "escape", "id": "game_A07", "t": "숫자 자물쇠 — 규정 숫자가 비밀번호", "c": "증빙 보관 5년 · 이의신청 10일 · 협약 30일 — 규정 숫자를 이어 붙이면 금고가 열립니다."}, {"sec": "escape", "id": "game_A08", "t": "분류 퍼즐 — 영수증 정리", "c": "연구비로 쓸 수 있는 것과 없는 것을 끌어다 나누면 서랍이 열립니다."}, {"sec": "escape", "id": "game_A09", "t": "소지품 합치기", "c": "방 곳곳에서 주운 물건을 합쳐 새 도구를 만드는 방탈출의 기본 퍼즐."}, {"sec": "escape", "id": "game_A10", "t": "포격 퍼즐 — 원래 게임으로 조준", "c": "사격대에 서면 옆모습 포격 화면으로 바뀝니다 — 선반 위 열쇠 상자를 각도·파워로 맞히기."}, {"sec": "escape", "id": "game_A11", "t": "포격으로 벽 뚫기 — 숨은 공간", "c": "케이요새의 지형 파괴를 퍼즐로 — 금 간 벽을 맞히면 숨은 공간이 열립니다."}, {"sec": "escape", "id": "game_A12", "t": "힌트 — 단계별 · 시간 감점", "c": "방향 → 구체 → 정답 3단계 힌트. 막혀서 포기하지 않게, 대신 기록에서 시간이 빠집니다."}, {"sec": "escape", "id": "game_A13", "t": "두 번째 방 — 연구실 화재 경보", "c": "정전과 경보 속에서 손전등으로 MSDS를 찾아라 — 보이는 범위가 좁아져 긴장감이 커집니다."}, {"sec": "escape", "id": "game_A14", "t": "순서 퍼즐 — 소화기 4단계", "c": "절차가 중요한 연구실안전은 순서 맞추기 퍼즐로 — 틀리면 경보가 커집니다."}, {"sec": "escape", "id": "game_A15", "t": "세 번째 방 — 사라진 연구노트", "c": "돋보기로 노트를 살펴 「확인자 서명이 빠진 쪽」을 찾아야 다음 문이 열립니다."}, {"sec": "escape", "id": "game_A16", "t": "협동 — 서로 다른 단서", "c": "두 사람에게 다른 단서를 보여 주면 대화해야만 풀립니다 (카드형 방탈출 게임의 협동 방식)."}, {"sec": "escape", "id": "game_A17", "t": "휴대폰에서도 그대로", "c": "설치 없이 링크로 접속 — 왼손 이동, 오른손 조사·사용. 세로 화면용 작은 지도."}, {"sec": "escape", "id": "game_A18", "t": "탈출 성공 — 기록과 복습", "c": "탈출 시간·힌트·순위와 함께, 오늘 연 자물쇠의 근거 규정 3개를 복습 카드로 남깁니다."}, {"sec": "escape", "id": "game_A19", "t": "오프라인 연계 — 캠퍼스 실물 단서", "c": "행사·오리엔테이션 때 실제 건물 곳곳에 QR 단서를 붙여 휴대폰 방탈출과 섞습니다."}, {"sec": "escape", "id": "game_A20", "t": "방 만들기 도구 — 부서가 직접", "c": "타일 지도 편집 + 퍼즐 칸에 규정 문장·정답만 넣으면 새 방 완성 (방탈출 게임들의 방 편집기 방식)."}, {"sec": "hide", "id": "game_B01", "t": "역할과 맵 고르기", "c": "숨는 팀과 술래로 나뉘고, 맵은 KIRD 홍보관·실험동·집행실·캠퍼스 중에서 고릅니다."}, {"sec": "hide", "id": "game_B02", "t": "무대 — KIRD 홍보관", "c": "전시 부스·탱크 진열대·조형물이 모두 숨을 곳. 홍보관을 구경하는 이유가 생깁니다."}, {"sec": "hide", "id": "game_B03", "t": "숨는 시간 60초", "c": "숨는 팀이 흩어지는 동안 술래는 대기실에서 기다립니다 — 화면 위 시계가 줄어듭니다."}, {"sec": "hide", "id": "game_B04", "t": "소품으로 변신", "c": "근처에 있는 소품만 고를 수 있어요 — 같은 소품이 많은 곳에 숨을수록 유리합니다 (프롭헌트 방식)."}, {"sec": "hide", "id": "game_B05", "t": "몸에 색칠하기", "c": "요즘 유행하는 색칠 숨바꼭질 방식 — 스포이트로 바닥색을 찍고 무늬까지 맞춰 배경에 섞입니다."}, {"sec": "hide", "id": "game_B06", "t": "내 화면 vs 술래 화면", "c": "숨는 팀끼리는 서로 테두리가 보이지만, 술래 화면에는 그냥 소품일 뿐입니다."}, {"sec": "hide", "id": "game_B07", "t": "술래 출발 — 손전등 시야", "c": "찾는 시간 3분. 술래는 손전등이 비추는 범위만 보여서 구석구석 돌아다녀야 합니다."}, {"sec": "hide", "id": "game_B08", "t": "조사탄 — 빗나가면 손해", "c": "의심 가는 소품에 조사탄을 쏩니다. 진짜 화분이면 조사탄이 하나 줄어요 — 아무 데나 쏘면 금방 바닥납니다."}, {"sec": "hide", "id": "game_B09", "t": "발견! — 소품마다 규정 한 줄", "c": "맞히면 위장이 벗겨지고, 그 소품에 담긴 규정이 뜹니다 (실험동 맵: 소화기 = 사용 순서)."}, {"sec": "hide", "id": "game_B10", "t": "30초마다 신호음", "c": "오래 숨기만 하면 재미가 없으니, 30초마다 숨은 탱크 위치에서 소리 파동이 퍼집니다."}, {"sec": "hide", "id": "game_B11", "t": "똑같은 상자 열 개 — 어느 것?", "c": "맵에는 같은 모양의 진짜 소품(미끼)을 넉넉히 깔아, 변신한 탱크가 섞일 곳을 만듭니다."}, {"sec": "hide", "id": "game_B12", "t": "맵 ② 예방의 실험동", "c": "위험물 드럼·경고 표지·소화기 사이 — 숨는 재미와 안전 소품 익히기를 함께."}, {"sec": "hide", "id": "game_B13", "t": "맵 ③ 신뢰의 집행실", "c": "증빙 상자·영수증 더미·금고 — 색칠로 나무 바닥에 섞인 탱크까지."}, {"sec": "hide", "id": "game_B14", "t": "맵 ④ KIRD 캠퍼스 (야외)", "c": "넓은 야외 맵은 「작은 지도 + 확대 화면」. 나무·덤불·정자·벤치 사이에 숨습니다."}, {"sec": "hide", "id": "game_B15", "t": "감염 모드 — 잡히면 술래 편", "c": "발견된 탱크가 빨간색으로 바뀌어 술래 팀에 합류 — 갈수록 찾는 눈이 늘어납니다."}, {"sec": "hide", "id": "game_B16", "t": "관전·중계 화면", "c": "관전자는 모든 위치가 보입니다 — 행사 대형 화면이나 사내 방송으로 중계하기 좋습니다."}, {"sec": "hide", "id": "game_B17", "t": "결과 — 칭호와 규정 카드", "c": "숨은 시간·발견 수로 칭호를 주고, 이번 판에 변신·발견한 소품의 규정 카드를 모읍니다."}, {"sec": "hide", "id": "game_B18", "t": "기관 SNS 숏폼 — 「KIRD 곳곳에 숨은 탱크」", "c": "최근 지자체·공공기관이 색칠 숨바꼭질 게임으로 자기 청사를 소개한 것처럼, 우리 캠퍼스 맵으로 숏폼을 만듭니다."}, {"sec": "hide", "id": "game_B19", "t": "휴대폰 가로 화면", "c": "왼손 이동, 오른손은 숨는 팀이면 「변신·색칠·신호」, 술래면 「조사탄」."}, {"sec": "hide", "id": "game_B20", "t": "소품 도감 — 숨으면서 모으는 규정", "c": "변신했거나 찾아낸 소품은 도감에 쌓이고, 소품마다 규정 한 줄이 붙습니다."}, {"sec": "chase", "id": "game_C01", "t": "역할 — 연구팀 4명 vs 「위조탱」 1명", "c": "퍼즐을 풀어 탈출하려는 연구팀과, 그들을 붙잡으려는 술래. 방탈출과 숨바꼭질을 한 판에."}, {"sec": "chase", "id": "game_C02", "t": "캠퍼스 전체 지도 — 단말기와 출구", "c": "단말기 7대가 건물 안팎에 흩어져 있고, 5대를 풀면 출구 두 곳에 전원이 들어옵니다."}, {"sec": "chase", "id": "game_C03", "t": "시작 — 흩어지는 연구팀", "c": "연구팀은 캠퍼스 네 곳에서, 술래는 중앙 광장에서 출발합니다."}, {"sec": "chase", "id": "game_C04", "t": "단말기 퍼즐 — 규정 3문제", "c": "단말기 앞에 서면 규정 문제가 연속으로 — 빨리, 정확히 풀어야 덜 노출됩니다."}, {"sec": "chase", "id": "game_C05", "t": "오답 경보 — 위치가 드러난다", "c": "틀리면 단말기에서 경보가 울리고, 술래 지도에 위치가 3초간 표시됩니다 (긴장의 핵심)."}, {"sec": "chase", "id": "game_C06", "t": "술래 화면 — 발자국과 경보", "c": "술래는 손전등 시야와 발자국 흔적, 오답 경보 표시로 연구팀을 추적합니다."}, {"sec": "chase", "id": "game_C07", "t": "위기 — 술래가 다가온다", "c": "술래가 가까워지면 화면 가장자리가 붉게 뛰고, 근처 소품으로 위장 버튼이 켜집니다."}, {"sec": "chase", "id": "game_C08", "t": "위장 성공 — 바로 옆을 지나간다", "c": "위장 중엔 움직일 수 없지만, 술래 화면에는 그냥 소화기. 숨바꼭질의 긴장이 탈출전 한가운데로."}, {"sec": "chase", "id": "game_C09", "t": "붙잡힘 — 격리실로", "c": "조사탄에 맞으면 위장이 벗겨지고 격리실로 옮겨집니다 — 동료가 구출할 때까지 대기."}, {"sec": "chase", "id": "game_C10", "t": "구출 — 격리실 자물쇠 풀기", "c": "동료가 격리실 앞에서 규정 문제를 풀면 구출 — 혼자 탈출보다 팀플레이가 유리하게."}, {"sec": "chase", "id": "game_C11", "t": "함께 풀면 빨라진다", "c": "두 명이 같은 단말기를 풀면 속도 ×1.7 — 대신 한곳에 모여 있으면 들킬 위험도 커집니다."}, {"sec": "chase", "id": "game_C12", "t": "단말기 5/5 — 출구 전원 ON", "c": "다섯 번째 단말기가 풀리면 출구가 빛나고, 마지막 관문 퍼즐을 풀면 문이 열립니다."}, {"sec": "chase", "id": "game_C13", "t": "연구팀 탈출 성공", "c": "절반 이상 빠져나가면 연구팀 승리 — 마지막까지 동료를 기다릴지, 먼저 나갈지는 팀의 선택."}, {"sec": "chase", "id": "game_C14", "t": "술래 승리", "c": "출구가 열리기 전에 절반 이상 붙잡으면 술래 승리. 결과 화면에서 양쪽 모두 규정 복습."}, {"sec": "chase", "id": "game_C15", "t": "건물 안 추격 — 본관 2층", "c": "건물 문으로 들어가면 실내 화면. 방 여러 개와 복도 — 문 하나로 술래를 따돌립니다."}, {"sec": "chase", "id": "game_C16", "t": "벽은 시야를 가린다", "c": "술래 손전등은 벽을 통과하지 못해요 — 방 안은 문 앞에 서야 보입니다 (시야 계산)."}, {"sec": "chase", "id": "game_C17", "t": "관전·중계 화면", "c": "전체 지도에 모두의 위치와 상태 — 연찬회·행사 대형 화면용. 관전 기능을 그대로 확장."}, {"sec": "chase", "id": "game_C18", "t": "결과 — 기여도와 정답률", "c": "단말기·구출·위장 기여도와 규정 정답률. 문항별 정답률은 교육 담당자의 학습 데이터가 됩니다."}, {"sec": "chase", "id": "game_C19", "t": "휴대폰 세로 화면", "c": "이동은 왼손, 오른손은 상황에 따라 「풀기·위장·구출」로 바뀌는 큰 버튼 하나."}, {"sec": "chase", "id": "game_C20", "t": "행사 운영 — 대형 화면 + 각자 휴대폰", "c": "연찬회·오리엔테이션: 참가자는 각자 휴대폰으로, 무대 화면엔 중계 — 별도 장비 없이 링크와 화면만."}]